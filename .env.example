# LLM Diagnostic Provider Configuration
# Choose: "gemini", "openai", "auto", or "heuristic"
LLM_PROVIDER=auto

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (Get from OpenAI Platform: https://platform.openai.com/)
OPENAI_API_KEY=

# Optional custom model override (e.g., gemini-1.5-flash, gemini-2.0-flash, gpt-4o-mini)
LLM_MODEL=gemini-1.5-flash
